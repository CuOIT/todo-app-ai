                        <Border Width="20" Height="20" CornerRadius="6" Background="#101927" BorderBrush="#25476E" BorderThickness="1" Margin="0,0,9,0">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Add task" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Grid x:Name="QuickAddEditor" Visibility="Collapsed" Background="#0D141F" MinHeight="58">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
                            Background="#0F1724"
                            BorderBrush="#25476E"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsHitTestVisible="False" />
                    <TextBox x:Name="QuickAddTitleInput"
                             Grid.Row="0"
                             Grid.Column="0"
                             Tag="{Binding}"
                             MinWidth="72"
                             Margin="9,8,5,2"
                             MinHeight="30"
                             Background="#111D2B"
                             BorderBrush="#31577E"
                             AutomationProperties.Name="Quick add task title"
                             ToolTip="Type a task title"
                             KeyDown="InlineTaskTitle_KeyDown" />
                    <Button Grid.Row="0" Grid.Column="1" Content="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="Create task" AutomationProperties.Name="Create task" Width="30" MinHeight="30" Padding="0" Margin="0,8,5,2" Background="#2F80ED" BorderBrush="#58A6FF" Click="ConfirmInlineTaskButton_Click" />
                    <Button Grid.Row="0" Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="Cancel" AutomationProperties.Name="Cancel quick add" Width="30" MinHeight="30" Padding="0" Margin="0,8,9,2" Click="CancelInlineTaskButton_Click" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
