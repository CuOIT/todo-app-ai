                                            <TextBlock x:Name="SelectedTaskPriorityFlag" Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" Foreground="#8B93A3" FontSize="10" Margin="0,0,4,0" />
                                            <TextBlock x:Name="SelectedTaskPriorityText" Text="--" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#1E3425" BorderBrush="#2D5937" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,6,6">
