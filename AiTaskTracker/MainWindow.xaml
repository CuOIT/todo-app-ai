                                                   Grid.Column="0"
                                                   Text="Select a date"
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   Margin="9,0"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="DetailDueCalendarButton"
                                                Grid.Column="1"
                                                Content="&#xE787;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Width="32"
                                                MinHeight="32"
                                                Padding="0"
                                                Margin="0"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                ToolTip="Select due date"
                                                Click="DetailDueCalendarButton_Click" />
                                        <Popup x:Name="DetailDuePopup"
                                               PlacementTarget="{Binding ElementName=DetailDueHost}"
                                               Placement="Bottom"
                                               HorizontalOffset="-90"
                                               AllowsTransparency="True"
                                               StaysOpen="False"
                                               PopupAnimation="Fade">
                                            <Border Background="#10141B"
                                                    BorderBrush="#2F80ED"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10"
                                                    Width="258">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="32" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0"
                                                                Content="&#xE76B;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Width="28"
                                                                MinHeight="28"
                                                                Padding="0"
                                                                Margin="0"
                                                                ToolTip="Previous month"
                                                                Click="DetailDuePreviousMonth_Click" />
                                                        <TextBlock x:Name="DetailDueMonthText"
                                                                   Grid.Column="1"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="SemiBold" />
                                                        <Button Grid.Column="2"
                                                                Content="&#xE76C;"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                Width="28"
                                                                MinHeight="28"
                                                                Padding="0"
                                                                Margin="0"
                                                                ToolTip="Next month"
                                                                Click="DetailDueNextMonth_Click" />
                                                    </Grid>
                                                    <UniformGrid x:Name="DetailDueCalendarGrid" Columns="7" />
                                                    <Border Height="1" Background="#252A33" Margin="0,8,0,8" />
                                                    <DockPanel LastChildFill="False">
                                                        <Button DockPanel.Dock="Left" Content="Clear" Margin="0" Click="DetailDueClear_Click" />
                                                        <Button DockPanel.Dock="Right" Content="Today" Margin="8,0,0,0" Click="DetailDueToday_Click" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
                                    <TextBlock Text="Estimate" Style="{StaticResource InspectorFieldLabel}" />
                                    <TextBox x:Name="EstimateInput" TextChanged="TaskInfoField_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
                                    <TextBlock Text="Tags" Style="{StaticResource InspectorFieldLabel}" />
                                    <TextBox x:Name="TagsInput" ToolTip="Comma separated tags" TextChanged="TaskInfoField_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                    <TextBlock Text="Blocked by" Style="{StaticResource InspectorFieldLabel}" />
                                    <TextBox x:Name="BlockedByInput" ToolTip="Comma separated task ids" TextChanged="TaskInfoField_Changed" />
                                </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Background="#151A22" BorderBrush="#2A3442" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock x:Name="SubtaskCountText" Text="0" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="SUBTASKS" Style="{StaticResource InspectorSectionTitle}" Margin="0" />
                                    </DockPanel>
                                    <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <TextBox x:Name="SubtaskInput" KeyDown="SubtaskInput_KeyDown" />
                                    <TextBlock Text="Add a checklist item" Margin="10,7,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource InputPlaceholderText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SubtaskInput}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                        <Button Grid.Column="1" Content="Add" Margin="0" Padding="12,5" Click="AddSubtaskButton_Click" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <ListBox x:Name="SubtaskList" MinHeight="54" MaxHeight="154" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource SubtaskInspectorTemplate}" ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                                        <TextBlock Text="No subtasks" IsHitTestVisible="False">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=SubtaskList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Background="#151A22" BorderBrush="#2A3442" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock x:Name="AttachmentCountText" Text="0" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="ATTACHMENTS" Style="{StaticResource InspectorSectionTitle}" Margin="0" />
                                    </DockPanel>
                                    <TextBlock Text="Link or local file path" Style="{StaticResource InspectorFieldLabel}" />
                                    <Grid>
                                        <TextBox x:Name="AttachmentInput" />
                                        <TextBlock Text="https://... or C:\path\file.ext" Margin="10,7,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource InputPlaceholderText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=AttachmentInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <TextBox x:Name="AttachmentTitleInput" ToolTip="Attachment title" />
                                    <TextBlock Text="Optional title" Margin="10,7,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource InputPlaceholderText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=AttachmentTitleInput}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                        <Button Grid.Column="1" Content="Attach" Margin="0" Padding="12,5" Click="AddAttachmentButton_Click" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <ListBox x:Name="AttachmentList" MinHeight="54" MaxHeight="132" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource AttachmentInspectorTemplate}" ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                                        <TextBlock Text="No attachments" IsHitTestVisible="False">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AttachmentList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InspectorCard}" Margin="0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <Border DockPanel.Dock="Right" Background="#151A22" BorderBrush="#2A3442" BorderThickness="1" CornerRadius="8" Padding="7,2">
                                            <TextBlock x:Name="LogCountText" Text="0" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="ACTIVITY" Style="{StaticResource InspectorSectionTitle}" Margin="0" />
                                    </DockPanel>
                                    <Grid>
                                        <TextBox x:Name="LogInput" AcceptsReturn="True" Height="68" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" KeyDown="LogInput_KeyDown" />
                                        <TextBlock Text="Add a progress update, handoff note, or AI action summary.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource InputPlaceholderText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=LogInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="Add log" Margin="0" Padding="12,5" Click="AddLogButton_Click" />
                                    </StackPanel>
                                    <Grid Margin="0,8,0,0">
                                        <ListBox x:Name="LogList" MinHeight="64" MaxHeight="190" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource LogInspectorTemplate}" ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                                        <TextBlock Text="No activity yet" IsHitTestVisible="False">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStateText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=LogList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="12" BorderBrush="#2A2F3A" BorderThickness="0,1,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#171B24" Offset="0" />
                                <GradientStop Color="#11151C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Left"
                                    Style="{StaticResource InspectorDangerButton}"
                                    Margin="0"
                                    Click="DeleteButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,7,0" />
                                    <TextBlock Text="Delete" />
                                </StackPanel>
                            </Button>
                            <Border DockPanel.Dock="Left"
                                    Background="#101722"
                                    BorderBrush="#202A38"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="9,5"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="TaskInfoSaveStateDot"
                                             Width="7"
                                             Height="7"
                                             Fill="#57D17B"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="TaskInfoSaveStateText"
                                               Text="Saved"
                                               Foreground="#8AE39D"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="SaveDetailsButton"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource InspectorPrimaryButton}"
                                    Margin="8,0,0,0"
                                    ToolTip="Save changes (Ctrl+S)"
                                    IsEnabled="False"
                                    Click="SaveDetailsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,7,0" />
                                    <TextBlock Text="Save" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MarkDoneButton"
                                    DockPanel.Dock="Right"
                                    Margin="0"
                                    Padding="14,5"
                                    Click="MarkDoneButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,7,0" />
                                    <TextBlock x:Name="MarkDoneButtonLabel" Text="Mark done" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="ToastHost"
                Grid.Row="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,26,18"
                Background="#111923"
                BorderBrush="#31577E"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,9"
                MinWidth="260"
                MaxWidth="420"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.30" Color="#02060B" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="10" />
            </Border.RenderTransform>
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left"
                        Width="24"
                        Height="24"
                        Background="#173A61"
                        BorderBrush="#31577E"
                        BorderThickness="1"
                        CornerRadius="7"
                        Margin="0,0,9,0">
                    <TextBlock Text="&#xE73E;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#8AE39D"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="ToastMessageText"
                           Text="Saved"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="14,12,14,14"
                Background="#0D1118"
                BorderBrush="#252C38"
                BorderThickness="1"
                CornerRadius="9"
                Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#A8C7FA" Margin="0,0,6,0" />
                            <TextBlock x:Name="FooterTaskCountText" Text="0 tasks" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#57D17B" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="FooterSaveStateText" Text="Saved locally" Foreground="#8AE39D" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#2DD4BF" Margin="0,0,6,0" />
                            <TextBlock x:Name="FooterMcpStateText" Text="MCP ready" Foreground="#B8FFF5" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,6,0" />
                            <TextBlock x:Name="FooterUpdatedText" Text="Updated --:--" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Background="#101722"
                        BorderBrush="#202A38"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9,5"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#57D17B" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Text="Workspace ready for user and AI updates"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
