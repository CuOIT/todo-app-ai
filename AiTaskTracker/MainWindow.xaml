                                </Grid>
                                <TextBlock x:Name="FirstTaskHintText"
                                           Text="Enter saves instantly. You can add details later in Task Info."
                                           Foreground="{StaticResource SubtleTextBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="TaskInfoPanel" Grid.Column="4" Width="0" MinWidth="0" Opacity="0" Visibility="Collapsed" Style="{StaticResource ShellPanelBorder}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
