                                              ItemsSource="{Binding Source={StaticResource PriorityOptions}}"
                                              ItemTemplate="{StaticResource PriorityOptionTemplate}"
                                              SelectionChanged="TaskInfoField_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
                                    <DockPanel Margin="0,0,0,5">
