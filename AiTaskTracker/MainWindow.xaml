                    Height="24"
                    CornerRadius="6"
                    Background="#202631"
                    HorizontalAlignment="Left"
                    ToolTip="{Binding Priority, Converter={StaticResource PriorityDisplayConverter}}">
                <TextBlock x:Name="KanbanPriorityFlag"
