                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#111A27" Offset="0" />
                                    <GradientStop Color="#0D121A" Offset="0.64" />
                                    <GradientStop Color="#0B0F16" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.32" Color="#02060B" />
                            </Border.Effect>
                            <StackPanel>
                                <Border Width="58" Height="58" Background="#14243A" BorderBrush="#31577E" BorderThickness="1" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,15">
                                    <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Foreground="#A8C7FA" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="TaskEmptyStateTitle" Text="No tasks match" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock x:Name="TaskEmptyStateText" Text="" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="430" />
                                <UniformGrid x:Name="FirstTaskBenefitPanel" Columns="3" Margin="0,20,0,0">
                                    <Border Background="#0B111B" BorderBrush="#25476E" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="#58A6FF" FontSize="14" HorizontalAlignment="Center" />
                                            <TextBlock Text="Capture fast" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" />
                                            <TextBlock Text="One line is enough" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0B111B" BorderBrush="#25476E" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Foreground="#2DD4BF" FontSize="14" HorizontalAlignment="Center" />
                                            <TextBlock Text="AI-readable" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" />
                                            <TextBlock Text="Logs and status stay clear" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0B111B" BorderBrush="#25476E" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#FACC15" FontSize="14" HorizontalAlignment="Center" />
                                            <TextBlock Text="Always local" Foreground="{StaticResource TextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,7,0,0" />
                                            <TextBlock Text="Ready before sync" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Button x:Name="ClearTaskFiltersButton"
                                        Content="Clear filters"
                                        HorizontalAlignment="Center"
                                        Margin="0,18,0,0"
