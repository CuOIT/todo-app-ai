            <Setter Property="Background" Value="#25161A" />
            <Setter Property="BorderBrush" Value="#5A2B31" />
            <Setter Property="Padding" Value="14,5" />
        </Style>
        <Style x:Key="EmptyStateText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,16" />
        </Style>
        <Style x:Key="InputPlaceholderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="10,8,10,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style x:Key="QuickAddButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#0B1018" />
            <Setter Property="BorderBrush" Value="#1B2635" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="QuickAddChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="QuickAddChrome" Property="Background" Value="#121A26" />
                                <Setter TargetName="QuickAddChrome" Property="BorderBrush" Value="#31577E" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="QuickAddChrome" Property="Background" Value="#102841" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckChrome"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="4"
                                    Background="#0F1218"
                                    BorderBrush="#4B5568"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Width="9"
                                      Height="7"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 0 3.5 L 3 6.5 L 9 0"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="#58A6FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckChrome" Property="Background" Value="#2F80ED" />
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="#58A6FF" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SubtaskInspectorTemplate">
            <Border Background="#0B1018"
                    BorderBrush="#202A39"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="9,8"
                    Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="18"
                            Height="18"
                            CornerRadius="5"
                            Background="#121F31"
                            BorderBrush="#31577E"
                            BorderThickness="1"
                            Margin="0,0,9,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#58A6FF" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0}%}" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AttachmentInspectorTemplate">
            <Border Background="#0B1018"
                    BorderBrush="#202A39"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="9,8"
                    Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#121F31" BorderBrush="#31577E" BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,9,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Type}" Foreground="#A8C7FA" FontSize="9" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Target}" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="LogInspectorTemplate">
            <Border Background="#0B1018"
                    BorderBrush="#202A39"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,9"
                    Margin="0,0,0,7">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}" Foreground="{StaticResource SubtleTextBrush}" FontSize="10" />
                        <TextBlock Text="{Binding ActorName}" Foreground="#A8C7FA" FontSize="11" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{Binding Message}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ListQuickAddTemplate">
            <Grid x:Name="QuickAddHost" MinHeight="42">
                <Button x:Name="QuickAddTrigger"
                        Tag="{Binding}"
                        Click="AddTaskInlineButton_Click"
                        Style="{StaticResource QuickAddButton}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        BorderThickness="0,1,0,1"
                        Padding="52,9,10,9"
                        Margin="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="20" Height="20" CornerRadius="6" Background="#121F31" BorderBrush="#31577E" BorderThickness="1" Margin="0,0,9,0">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Add task" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Grid x:Name="QuickAddEditor" Visibility="Collapsed" Background="#0D141F" Margin="0,1,0,0" MinHeight="58">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="4"
                            Background="#101927"
                            BorderBrush="#25476E"
                            BorderThickness="0,1,0,1"
                            IsHitTestVisible="False" />
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="#58A6FF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox x:Name="QuickAddTitleInput"
                             Grid.Row="0"
                             Grid.Column="1"
                             Tag="{Binding}"
                             Margin="0,8,6,2"
                             MinHeight="30"
                             Background="#111D2B"
                             BorderBrush="#31577E"
                             AutomationProperties.Name="Quick add task title"
                             ToolTip="Type a task title"
                             KeyDown="InlineTaskTitle_KeyDown" />
                    <Button Grid.Row="0" Grid.Column="2" Content="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="Create task" AutomationProperties.Name="Create task" Width="30" MinHeight="30" Padding="0" Margin="0,8,6,2" Background="#2F80ED" BorderBrush="#58A6FF" Click="ConfirmInlineTaskButton_Click" />
                    <Button Grid.Row="0" Grid.Column="3" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="Cancel" AutomationProperties.Name="Cancel quick add" Width="30" MinHeight="30" Padding="0" Margin="0,8,8,2" Click="CancelInlineTaskButton_Click" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="3"
                               Text="Enter to save  /  Esc to cancel"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontSize="10"
                               Margin="0,0,8,6" />
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="BoardQuickAddTemplate">
            <Grid x:Name="QuickAddHost" MinHeight="40">
