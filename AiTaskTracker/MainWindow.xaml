                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="PriorityOptionTemplate">
            <Border x:Name="PriorityOptionBadge" MinWidth="104" Height="24" Padding="7,0" CornerRadius="6" Background="#202631" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="PriorityOptionFlag"
                               Text="&#xE7C1;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#7DD3FC"
                               FontSize="11"
                               Margin="0,0,5,0" />
                    <TextBlock x:Name="PriorityOptionLabel"
                               Text="{Binding Converter={StaticResource PriorityDisplayConverter}}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="emergen">
                    <Setter TargetName="PriorityOptionBadge" Property="Background" Value="#5A1F24" />
                    <Setter TargetName="PriorityOptionFlag" Property="Foreground" Value="#FF6B6B" />
                    <Setter TargetName="PriorityOptionLabel" Property="Foreground" Value="#FFD1D1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="high">
                    <Setter TargetName="PriorityOptionBadge" Property="Background" Value="#573A12" />
                    <Setter TargetName="PriorityOptionFlag" Property="Foreground" Value="#F59E0B" />
                    <Setter TargetName="PriorityOptionLabel" Property="Foreground" Value="#FFE2A8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="med">
                    <Setter TargetName="PriorityOptionBadge" Property="Background" Value="#143B42" />
                    <Setter TargetName="PriorityOptionFlag" Property="Foreground" Value="#2DD4BF" />
                    <Setter TargetName="PriorityOptionLabel" Property="Foreground" Value="#B8FFF5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="low">
                    <Setter TargetName="PriorityOptionBadge" Property="Background" Value="#202631" />
                    <Setter TargetName="PriorityOptionFlag" Property="Foreground" Value="#8B93A3" />
                    <Setter TargetName="PriorityOptionLabel" Property="Foreground" Value="#A1A8B5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="StatusOptionTemplate">
            <Border x:Name="StatusOptionBadge" MinWidth="104" Height="24" Padding="8,0" CornerRadius="6" Background="{StaticResource GrayBadgeBrush}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Converter={StaticResource StatusDisplayConverter}}" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="in_progress">
                    <Setter TargetName="StatusOptionBadge" Property="Background" Value="{StaticResource BlueBadgeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="review">
                    <Setter TargetName="StatusOptionBadge" Property="Background" Value="{StaticResource PurpleBadgeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="done">
                    <Setter TargetName="StatusOptionBadge" Property="Background" Value="{StaticResource GreenBadgeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="cancelled">
                    <Setter TargetName="StatusOptionBadge" Property="Background" Value="#444B57" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="blocked">
                    <Setter TargetName="StatusOptionBadge" Property="Background" Value="#A34712" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <x:Array x:Key="PriorityOptions" Type="{x:Type sys:String}">
            <sys:String>emergen</sys:String>
            <sys:String>high</sys:String>
            <sys:String>med</sys:String>
            <sys:String>low</sys:String>
        </x:Array>
        <x:Array x:Key="StatusOptions" Type="{x:Type sys:String}">
            <sys:String>backlog</sys:String>
            <sys:String>ready</sys:String>
            <sys:String>in_progress</sys:String>
            <sys:String>blocked</sys:String>
            <sys:String>review</sys:String>
            <sys:String>done</sys:String>
            <sys:String>cancelled</sys:String>
        </x:Array>
        <DataTemplate x:Key="KanbanCardTemplate">
            <Border x:Name="KanbanCardChrome"
                    Margin="0,0,0,10"
                    Padding="10"
                    MinHeight="98"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#02060B" />
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#121821" />
                        <Setter Property="BorderBrush" Value="#273241" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#17202B" />
                                <Setter Property="BorderBrush" Value="#50627A" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="#17283E" />
                                <Setter Property="BorderBrush" Value="#2F80ED" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Move to">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="#A8C7FA" FontSize="12" />
                            </MenuItem.Icon>
                            <MenuItem Header="TO-DO" Tag="backlog" Click="MoveTaskMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Foreground="#A1A8B5" FontSize="12" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="IN-PROGRESS" Tag="in_progress" Click="MoveTaskMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="#58A6FF" FontSize="12" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="DONE" Tag="done" Click="MoveTaskMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#57D17B" FontSize="12" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="CLOSE" Tag="cancelled" Click="MoveTaskMenuItem_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#A1A8B5" FontSize="12" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="Open task info" Click="OpenTaskInfoMenuItem_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#A8C7FA" FontSize="12" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Delete task" Foreground="{StaticResource DangerBrush}" Click="DeleteTaskMenuItem_Click">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DangerBrush}" FontSize="12" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" LastChildFill="True" Margin="0,0,8,0">
                            <Border DockPanel.Dock="Left"
                                    Width="3"
                                    Height="20"
                                    CornerRadius="2"
                                    Background="#3B4556"
                                    Margin="0,1,8,0"
                                    ToolTip="Drag task">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0.5" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="Background" Value="#58A6FF" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="done">
                                                <Setter Property="Background" Value="#57D17B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="cancelled">
                                                <Setter Property="Background" Value="#7D8594" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ContentControl Grid.Column="1"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource KanbanPriorityIconTemplate}"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                x:Name="KanbanDeleteButton"
                                Content="&#xE74D;"
                                Style="{StaticResource KanbanCardDangerIconButton}"
                                Opacity="0.38"
                                ToolTip="Delete task"
                                AutomationProperties.Name="Delete task"
                                PreviewMouseLeftButtonDown="DeleteTaskButton_PreviewMouseLeftButtonDown"
                                Click="DeleteTaskButton_Click" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0">
                            <Border x:Name="KanbanAssigneeChip"
                                    Background="#0D121A"
                                    BorderBrush="#202A39"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="5,3"
                                    Margin="0,0,6,6">
                                <Border Width="18"
                                        Height="18"
                                        Background="#173A61"
                                        BorderBrush="#31577E"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        ToolTip="{Binding Assignee}">
                                    <TextBlock Text="&#xE77B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#A8C7FA"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <Border Background="#0D121A"
                                    BorderBrush="#202A39"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="6,3"
                                    Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               FontSize="10"
                                               Margin="0,0,5,0" />
                                    <TextBlock x:Name="KanbanDueDateText"
                                               Text="{Binding DueDateLocal, StringFormat=Due {0}}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <Button Grid.Column="1"
                                x:Name="KanbanInfoButton"
                                Content="&#xE946;"
                                Style="{StaticResource KanbanCardIconButton}"
                                Margin="6,0,0,6"
                                FontSize="12"
                                Opacity="0.62"
                                ToolTip="Task info"
                                AutomationProperties.Name="Open task info"
                                PreviewMouseLeftButtonDown="OpenTaskInfoButton_PreviewMouseLeftButtonDown"
                                Click="OpenTaskInfoButton_Click" />
                    </Grid>
                    <ProgressBar x:Name="KanbanProgressBar"
                                 Grid.Row="2"
                                 Value="{Binding ProgressPercent}"
                                 Style="{StaticResource KanbanProgressBarStyle}"
                                 Margin="0,3,0,0" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="KanbanDeleteButton" Property="Opacity" Value="1" />
                    <Setter TargetName="KanbanInfoButton" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="KanbanDeleteButton" Property="Opacity" Value="1" />
                    <Setter TargetName="KanbanInfoButton" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DueDateLocal}" Value="">
                    <Setter TargetName="KanbanDueDateText" Property="Text" Value="No due date" />
                    <Setter TargetName="KanbanDueDateText" Property="Opacity" Value="0.65" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Assignee}" Value="">
                    <Setter TargetName="KanbanAssigneeChip" Property="Opacity" Value="0.72" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="done">
                    <Setter Property="Foreground" TargetName="KanbanDueDateText" Value="#7DDC8F" />
                    <Setter Property="Foreground" TargetName="KanbanProgressBar" Value="#57D17B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="cancelled">
                    <Setter Property="Foreground" TargetName="KanbanDueDateText" Value="#A1A8B5" />
                    <Setter Property="Foreground" TargetName="KanbanProgressBar" Value="#7D8594" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="blocked">
                    <Setter Property="Foreground" TargetName="KanbanProgressBar" Value="#F97316" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0D1016"
                BorderBrush="#202631"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" Background="#173A61" BorderBrush="#31577E" BorderThickness="1" CornerRadius="6" Margin="0,0,9,0">
                        <Image Source="{StaticResource AppIcon}" Width="15" Height="15" />
                    </Border>
                    <TextBlock Text="AI Task Tracker" FontSize="12" FontWeight="SemiBold" Foreground="#DCE2EC" VerticalAlignment="Center" />
                    <Border Width="1" Height="13" Background="#303846" Margin="11,0" />
                    <TextBlock Text="Local workspace" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#x2014;"
                            Style="{StaticResource WindowControlButton}"
                            ToolTip="Minimize"
                            AutomationProperties.Name="Minimize window"
                            Click="MinimizeWindowButton_Click" />
                    <Button x:Name="MaximizeWindowButton"
                            Content="&#x25A1;"
                            Style="{StaticResource WindowControlButton}"
                            ToolTip="Maximize"
                            AutomationProperties.Name="Maximize window"
                            Click="MaximizeWindowButton_Click" />
                    <Button Content="&#x00D7;"
                            Style="{StaticResource WindowCloseButton}"
                            ToolTip="Close"
                            AutomationProperties.Name="Close window"
                            Click="CloseWindowButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="14,12,14,0" Background="#10131A" BorderBrush="#282F3B" BorderThickness="1" CornerRadius="10" Padding="16,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource MetricChip}">
                        <StackPanel>
                            <TextBlock Text="Active" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                            <TextBlock x:Name="ActiveTasksMetric" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricChip}">
                        <StackPanel>
                            <TextBlock Text="Progress" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                            <TextBlock x:Name="InProgressMetric" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="#58A6FF" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricChip}">
                        <StackPanel>
                            <TextBlock Text="Due" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                            <TextBlock x:Name="DueSoonMetric" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="#FBBF24" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricChip}">
                        <StackPanel>
                            <TextBlock Text="Closed" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" />
                            <TextBlock x:Name="CompletedMetric" Text="0" FontSize="18" FontWeight="SemiBold" Foreground="#57D17B" />
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="PinButton"
                                  Content="&#xE718;"
                                  Style="{StaticResource IconToggleButtonStyle}"
                                  ToolTip="Keep window on top"
                                  AutomationProperties.Name="Keep window on top"
                                  Click="PinButton_Click" />
                    <Button Content="&#xE897;"
                            Width="44"
                            Height="44"
                            MinHeight="44"
                            Padding="0"
                            Margin="0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="15"
                            ToolTip="Quick start"
                            AutomationProperties.Name="Quick start"
                            Click="QuickStartButton_Click" />
                    <Button Content="&#xE713;"
                            Width="44"
                            Height="44"
                            MinHeight="44"
                            Padding="0"
                            Margin="0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="15"
                            ToolTip="Settings"
                            AutomationProperties.Name="Settings"
                            Click="SettingsButton_Click" />
                    <Button Content="&#xE946;"
                            Width="44"
                            Height="44"
                            MinHeight="44"
                            Padding="0"
                            Margin="0"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="15"
                            ToolTip="About and release info"
                            AutomationProperties.Name="About and release info"
                            Click="AboutButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" Background="#152B48" BorderBrush="#2C5078" BorderThickness="1" CornerRadius="9" Margin="0,0,12,0">
                        <TextBlock Text="&#xE787;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#9CC8FF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Today"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Ellipse Width="7" Height="7" Fill="#57D17B" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TodayDateText" Text="Today" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Text="  /  Live workspace" Foreground="#57D17B" FontSize="12" />
                            <TextBlock x:Name="StoragePathText" Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="14,16,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FocusColumn" Width="300" />
                <ColumnDefinition x:Name="FocusSpacerColumn" Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TaskInfoSpacerColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="FocusPanel" Grid.Column="0" Style="{StaticResource ShellPanelBorder}" Padding="12">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2,2,2,10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="28"
                                        Height="28"
                                        Background="#173A61"
                                        BorderBrush="#31577E"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Margin="0,0,9,0">
                                    <TextBlock Text="&#xE7C1;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="#A8C7FA"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Today Focus" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="#11291D" BorderBrush="#245C38" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="LIVE" Foreground="#8AE39D" FontSize="9" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="User + AI priorities" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel>
                            <Border Style="{StaticResource FocusSectionBorder}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="#58A6FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NowHeader" Style="{StaticResource SectionTitle}" Foreground="#58A6FF" />
                                    </DockPanel>
                                    <Grid>
                                        <ListBox x:Name="NowList" MaxHeight="280" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemTemplate="{StaticResource FocusTaskTemplate}" SelectionChanged="FocusList_SelectionChanged" />
                                        <Border IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource FocusEmptyStateBorder}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=NowList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="#58A6FF" FontSize="16" HorizontalAlignment="Center" />
                                                <TextBlock Text="Nothing active" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FocusSectionBorder}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="#F97316" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BlockedHeader" Style="{StaticResource SectionTitle}" Foreground="#F97316" />
                                    </DockPanel>
                                    <Grid>
                                        <ListBox x:Name="BlockedList" MaxHeight="220" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemTemplate="{StaticResource FocusTaskTemplate}" SelectionChanged="FocusList_SelectionChanged" />
                                        <Border IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource FocusEmptyStateBorder}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="BorderBrush" Value="#3A2B23" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=BlockedList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#F97316" FontSize="16" HorizontalAlignment="Center" />
                                                <TextBlock Text="No blocked tasks" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FocusSectionBorder}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DueHeader" Style="{StaticResource SectionTitle}" Foreground="#FBBF24" />
                                    </DockPanel>
                                    <Grid>
                                        <ListBox x:Name="DueList" MaxHeight="360" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemTemplate="{StaticResource FocusTaskTemplate}" SelectionChanged="FocusList_SelectionChanged" />
                                        <Border IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource FocusEmptyStateBorder}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="BorderBrush" Value="#3E3520" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=DueList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="#FBBF24" FontSize="16" HorizontalAlignment="Center" />
                                                <TextBlock Text="No upcoming deadlines" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource FocusSectionBorder}" Margin="0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="#A78BFA" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="RecentHeader" Style="{StaticResource SectionTitle}" Foreground="#A78BFA" />
                                    </DockPanel>
                                    <Grid>
                                        <ListBox x:Name="RecentList" MaxHeight="300" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemTemplate="{StaticResource FocusTaskTemplate}" SelectionChanged="FocusList_SelectionChanged" />
                                        <Border IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource FocusEmptyStateBorder}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="BorderBrush" Value="#332C4D" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=RecentList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="#A78BFA" FontSize="16" HorizontalAlignment="Center" />
                                                <TextBlock Text="No recent changes" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ShellPanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="14,14,14,12" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="Tasks" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Capture, sort, and hand off work without losing context" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Background="#0D1117" BorderBrush="#2A3342" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ClickUpViewButton"
                                            Content="List"
                                            Tag="0"
                                            Style="{StaticResource ViewSwitchButton}"
                                            Click="ViewModeButton_Click" />
                                    <Button x:Name="KanbanViewButton"
                                            Content="Board"
                                            Tag="1"
                                            Style="{StaticResource ViewSwitchButton}"
                                            Margin="4,0,0,0"
                                            Click="ViewModeButton_Click" />
                                </StackPanel>
                            </Border>
                            <ComboBox x:Name="ViewModeInput" Width="140" SelectedIndex="0" Visibility="Collapsed" SelectionChanged="ViewModeInput_SelectionChanged">
                                <ComboBoxItem Content="ClickUp-lite" />
                                <ComboBoxItem Content="Kanban" />
                            </ComboBox>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="&#xE72C;"
                                Style="{StaticResource ToolbarIconButton}"
                                ToolTip="Refresh tasks"
                                AutomationProperties.Name="Refresh tasks"
                                Click="RefreshButton_Click" />
                        <ComboBox x:Name="StatusFilterInput" DockPanel.Dock="Right" Width="132" Margin="8,0,0,0" Style="{StaticResource ToolbarSelect}" ToolTip="Filter by status" AutomationProperties.Name="Filter tasks by status">
                            <ComboBoxItem Content="All statuses" Tag="all" />
                            <ComboBoxItem Content="To do" Tag="backlog" />
                            <ComboBoxItem Content="Ready" Tag="ready" />
                            <ComboBoxItem Content="In progress" Tag="in_progress" />
                            <ComboBoxItem Content="Blocked" Tag="blocked" />
                            <ComboBoxItem Content="Review" Tag="review" />
                            <ComboBoxItem Content="Done" Tag="done" />
                            <ComboBoxItem Content="Closed" Tag="cancelled" />
                        </ComboBox>
                        <Border DockPanel.Dock="Right" Width="230" Height="32" Margin="8,0,0,0" Background="#0F141C" BorderBrush="#2A3442" BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="SearchInput"
                                     Padding="30,4,30,4"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     ToolTip="Search tasks"
                                     AutomationProperties.Name="Search tasks" />
                            <TextBlock Text="Search tasks" Margin="30,0,30,0" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="ClearSearchButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="Clear search" AutomationProperties.Name="Clear search" Width="24" Height="24" MinHeight="24" Padding="0" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="ClearSearchButton_Click" />
                        </Grid>
                        </Border>
                        <TextBlock x:Name="FilterResultText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Visibility="Collapsed" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="TasksGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  IsReadOnly="False"
                                  SelectionMode="Single"
                                  SelectionChanged="TasksGrid_SelectionChanged"
                                  CellEditEnding="CellEditEnding"
                                  RowEditEnding="RowEditEnding">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <Expander IsExpanded="True" Margin="0,10,0,0">
                                                            <Expander.Header>
                                                                <Border Background="#0D121A" BorderBrush="#202A39" BorderThickness="0,0,0,1" Padding="10,7,10,8">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border x:Name="GroupBadge" MinWidth="86" Height="24" Padding="9,0" BorderThickness="1" CornerRadius="7">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{StaticResource GrayBadgeBrush}" />
                                                                                <Setter Property="BorderBrush" Value="#4B5568" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="IN PROGRESS">
                                                                                        <Setter Property="Background" Value="{StaticResource BlueBadgeBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="#58A6FF" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="REVIEW">
                                                                                        <Setter Property="Background" Value="{StaticResource PurpleBadgeBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="#A78BFA" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="DONE">
                                                                                        <Setter Property="Background" Value="{StaticResource GreenBadgeBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="#57D17B" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="BLOCKED">
                                                                                        <Setter Property="Background" Value="#A34712" />
                                                                                        <Setter Property="BorderBrush" Value="#F97316" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="TO DO">
                                                                                        <Setter Property="Background" Value="{StaticResource GrayBadgeBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="#697386" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Name}" Value="CANCELLED">
                                                                                        <Setter Property="Background" Value="#444B57" />
                                                                                        <Setter Property="BorderBrush" Value="#697386" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Border Background="#151A22" BorderBrush="#2A3442" BorderThickness="1" CornerRadius="8" MinWidth="24" Height="24" Padding="7,0" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding ItemCount}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </StackPanel>
                                                                </Border>
                                                            </Expander.Header>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <ItemsPresenter Grid.Row="0" />
                                                                <Border Grid.Row="1"
                                                                        MinHeight="44"
                                                                        Background="#0B1018"
                                                                        BorderBrush="#1E2836"
                                                                        BorderThickness="0,1,0,1">
                                                                    <ContentControl Content="{Binding Name}" ContentTemplate="{StaticResource ListQuickAddTemplate}" />
                                                                </Border>
                                                            </Grid>
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Pin" Width="48">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsPinned, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource TaskCheckBoxStyle}"
                                                      ToolTip="Pin task"
                                                      AutomationProperties.Name="Pin task" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Name" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0"
                                                         Width="8"
                                                         Height="8"
                                                         Fill="#2F80ED"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Left" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding ShortId}"
                                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="  -  "
                                                                   Foreground="#394150"
                                                                   FontSize="10" />
                                                        <TextBlock Text="{Binding UpdatedAtLocal, StringFormat=Updated {0}}"
                                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="AssigneeColumn" Header="Assignee" Width="118" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="AssigneeChip"
                                                    Background="#151A22"
                                                    BorderBrush="#2A3342"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="5,3"
                                                    HorizontalAlignment="Left"
                                                    MinWidth="92">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="22"
                                                            Height="22"
                                                            CornerRadius="11"
                                                            Background="#173A61"
                                                            BorderBrush="#31577E"
                                                            BorderThickness="1"
                                                            Margin="0,0,7,0">
                                                        <TextBlock Text="{Binding Assignee, Converter={StaticResource AssigneeInitialsConverter}}"
                                                                   Foreground="#A8C7FA"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock x:Name="AssigneeText"
                                                               Text="{Binding Assignee}"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="58" />
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Assignee}" Value="">
                                                    <Setter TargetName="AssigneeText" Property="Text" Value="Unassigned" />
                                                    <Setter TargetName="AssigneeText" Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                                    <Setter TargetName="AssigneeChip" Property="Opacity" Value="0.72" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="DueDateColumn" Header="Due date" Width="118">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Click="InlineDueDateButton_Click"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    MinHeight="26"
                                                    Padding="7,3"
                                                    Margin="0"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    ToolTip="Select due date"
                                                    AutomationProperties.Name="Select due date">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding DueDateLocal}" />
                                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DueDateLocal}" Value="">
                                                                        <Setter Property="Text" Value="Set date" />
                                                                        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               Text="&#xE787;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{StaticResource SubtleTextBrush}"
                                                               FontSize="11"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Priority" Width="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <StaticResource ResourceKey="PriorityBadgeTemplate" />
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource PriorityOptions}}"
                                                      ItemTemplate="{StaticResource PriorityOptionTemplate}"
                                                      SelectedItem="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="142">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <StaticResource ResourceKey="StatusBadgeTemplate" />
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Source={StaticResource StatusOptions}}"
                                                      ItemTemplate="{StaticResource StatusOptionTemplate}"
                                                      SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="CommentsColumn" Header="Comments" IsReadOnly="True" Width="86">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#151A22"
                                                    BorderBrush="#2A3442"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Left"
                                                    MinWidth="44">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE90A;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Logs.Count}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="96" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel x:Name="ListRowActions" Orientation="Horizontal" HorizontalAlignment="Right" Opacity="0.48">
                                                <Button Content="&#xE946;" Style="{StaticResource ListActionButton}" ToolTip="Task info" AutomationProperties.Name="Open task info" PreviewMouseLeftButtonDown="OpenTaskInfoButton_PreviewMouseLeftButtonDown" Click="OpenTaskInfoButton_Click" />
                                                <Button Content="&#xE712;" Style="{StaticResource ListActionButton}" ToolTip="Task actions" AutomationProperties.Name="Task actions" Click="TaskActionsButton_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="Move to">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="#A8C7FA" FontSize="12" />
                                                                </MenuItem.Icon>
                                                                <MenuItem Header="TO-DO" Tag="backlog" Click="MoveTaskMenuItem_Click">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Foreground="#A1A8B5" FontSize="12" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="IN-PROGRESS" Tag="in_progress" Click="MoveTaskMenuItem_Click">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Foreground="#58A6FF" FontSize="12" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="DONE" Tag="done" Click="MoveTaskMenuItem_Click">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#57D17B" FontSize="12" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="CLOSE" Tag="cancelled" Click="MoveTaskMenuItem_Click">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#A1A8B5" FontSize="12" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </MenuItem>
                                                            <MenuItem Header="Open task info" Click="OpenTaskInfoMenuItem_Click">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#A8C7FA" FontSize="12" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="Delete task" Foreground="{StaticResource DangerBrush}" Click="DeleteTaskMenuItem_Click">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DangerBrush}" FontSize="12" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <Button Content="&#xE74D;" Style="{StaticResource ListActionButton}" Margin="0" Foreground="{StaticResource DangerBrush}" ToolTip="Delete task" AutomationProperties.Name="Delete task" PreviewMouseLeftButtonDown="DeleteTaskButton_PreviewMouseLeftButtonDown" Click="DeleteTaskButton_Click" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter TargetName="ListRowActions" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter TargetName="ListRowActions" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ScrollViewer x:Name="KanbanPanel"
                                      Visibility="Collapsed"
                                      Margin="12,0,12,12"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch"
                                      PanningMode="HorizontalOnly">
                            <Grid MinWidth="804">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="190" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" MinWidth="190" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" MinWidth="190" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" MinWidth="190" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource KanbanColumnBorder}">
                                <DockPanel LastChildFill="False">
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="#8B93A3" Margin="0,0,7,0" />
                                            <TextBlock x:Name="TodoKanbanHeader" Text="TO-DO" FontWeight="SemiBold" Foreground="#C6CBD5" />
                                        </StackPanel>
                                        <Border Grid.Column="1" MinWidth="24" Height="22" Background="#202631" BorderBrush="#343B49" BorderThickness="1" CornerRadius="11" Padding="7,0">
                                            <TextBlock x:Name="TodoKanbanCount" Text="0" Foreground="#C6CBD5" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Grid DockPanel.Dock="Top">
                                        <ListBox x:Name="TodoKanbanList" Tag="todo" AllowDrop="True" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemTemplate="{StaticResource KanbanCardTemplate}" ItemContainerStyle="{StaticResource KanbanListItemStyle}" SelectionChanged="KanbanList_SelectionChanged" DragEnter="KanbanList_DragEnter" DragOver="KanbanList_DragOver" DragLeave="KanbanList_DragLeave" Drop="KanbanList_Drop" />
                                        <Border IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource KanbanEmptyStateBorder}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=TodoKanbanList}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Foreground="#8B93A3" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="No tasks" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="TodoDropOverlay" Style="{StaticResource KanbanDropOverlay}">
