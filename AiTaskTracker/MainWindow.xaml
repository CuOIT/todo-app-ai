                <DataTrigger Binding="{Binding Priority}" Value="high">
                    <Setter TargetName="KanbanPriorityIconBadge" Property="Background" Value="#573A12" />
                    <Setter TargetName="KanbanPriorityFlag" Property="Foreground" Value="#F59E0B" />
