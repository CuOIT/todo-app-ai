                    <Setter TargetName="PriorityLabel" Property="Foreground" Value="#FFD1D1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="high">
                    <Setter TargetName="PriorityBadge" Property="Background" Value="#573A12" />
                    <Setter TargetName="PriorityFlag" Property="Foreground" Value="#F59E0B" />
                    <Setter TargetName="PriorityLabel" Property="Foreground" Value="#FFE2A8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="med">
                    <Setter TargetName="PriorityBadge" Property="Background" Value="#143B42" />
                    <Setter TargetName="PriorityFlag" Property="Foreground" Value="#2DD4BF" />
                    <Setter TargetName="PriorityLabel" Property="Foreground" Value="#B8FFF5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="low">
                    <Setter TargetName="PriorityBadge" Property="Background" Value="#202631" />
                    <Setter TargetName="PriorityFlag" Property="Foreground" Value="#8B93A3" />
                    <Setter TargetName="PriorityLabel" Property="Foreground" Value="#A1A8B5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="KanbanPriorityIconTemplate">
            <Border x:Name="KanbanPriorityIconBadge"
