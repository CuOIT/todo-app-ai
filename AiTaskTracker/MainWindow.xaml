                                <ProgressBar x:Name="SelectedTaskHeaderProgressBar"
                                             Value="0"
                                             Style="{StaticResource KanbanProgressBarStyle}"
                                             Height="5"
                                             Margin="0,10,12,0" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="&#xE711;"
                                    Style="{StaticResource InspectorIconButton}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    ToolTip="Close task info"
                                    AutomationProperties.Name="Close task info"
                                    Click="CloseTaskInfoButton_Click" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <StackPanel Margin="16,14,16,112">
                            <Border Style="{StaticResource InspectorCard}">
                                <StackPanel>
                                    <TextBlock Text="DESCRIPTION" Style="{StaticResource InspectorSectionTitle}" />
                                    <Grid>
                                        <TextBox x:Name="NotesInput" AcceptsReturn="True" Height="78" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="TaskInfoField_Changed" />
                                        <TextBlock Text="Capture context, decisions, or the next concrete action.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource InputPlaceholderText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NotesInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InspectorCard}">
