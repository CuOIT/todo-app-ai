        <Style x:Key="KanbanListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="SizeAll" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="KanbanCard_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="KanbanCard_PreviewMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="KanbanCard_PreviewMouseLeftButtonUp" />
        </Style>
        <Style x:Key="KanbanProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#252A33" />
            <Setter Property="Foreground" Value="#2F80ED" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="TemplateRoot" ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="FocusTaskTemplate">
            <Border Padding="10,9"
                    CornerRadius="8"
                    Margin="0,0,0,8"
                    Cursor="Hand"
                    ToolTip="Open task info"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.HelpText="Open task info"
                    MouseLeftButtonUp="FocusTask_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#111822" />
                        <Setter Property="BorderBrush" Value="#223044" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="#162033" />
                                <Setter Property="BorderBrush" Value="#3F6EA0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="FocusStatusAccent"
                            Grid.Column="0"
                            Background="#2F80ED"
                            CornerRadius="2"
                            Opacity="0.9" />
                    <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
                        <Border x:Name="FocusStatusBadge" Background="#202631" CornerRadius="5" Padding="6,2" MinWidth="70">
                            <TextBlock x:Name="FocusStatusLabel" Text="{Binding StatusDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Border>
                        <Border x:Name="FocusPriorityBadge" MinWidth="78" Height="20" Background="#202631" CornerRadius="5" Padding="5,0" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="FocusPriorityFlag" Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" Foreground="#7DD3FC" FontSize="10" Margin="0,0,4,0" />
                                <TextBlock x:Name="FocusPriorityLabel" Text="{Binding Priority, Converter={StaticResource PriorityDisplayConverter}}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <DockPanel Grid.Row="2" Margin="0,7,0,0">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ProgressPercent, StringFormat={}{0}%}"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0" />
                        <TextBlock x:Name="FocusDueDateText"
                                   Text="{Binding DueDateLocal, StringFormat=Due {0}}"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar Grid.Row="3"
                                 Value="{Binding ProgressPercent}"
                                 Style="{StaticResource KanbanProgressBarStyle}"
                                 Margin="0,5,0,0" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DueDateLocal}" Value="">
                    <Setter TargetName="FocusDueDateText" Property="Text" Value="No due date" />
                    <Setter TargetName="FocusDueDateText" Property="Opacity" Value="0.65" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="in_progress">
                    <Setter TargetName="FocusStatusBadge" Property="Background" Value="#173A61" />
                    <Setter TargetName="FocusStatusLabel" Property="Foreground" Value="#A8C7FA" />
                    <Setter TargetName="FocusStatusAccent" Property="Background" Value="#58A6FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="blocked">
                    <Setter TargetName="FocusStatusBadge" Property="Background" Value="#3A2217" />
                    <Setter TargetName="FocusStatusLabel" Property="Foreground" Value="#FDBA74" />
                    <Setter TargetName="FocusStatusAccent" Property="Background" Value="#F97316" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="done">
                    <Setter TargetName="FocusStatusBadge" Property="Background" Value="#1E3425" />
                    <Setter TargetName="FocusStatusLabel" Property="Foreground" Value="#8AE39D" />
                    <Setter TargetName="FocusStatusAccent" Property="Background" Value="#57D17B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="cancelled">
                    <Setter TargetName="FocusStatusAccent" Property="Background" Value="#7D8594" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="emergen">
                    <Setter TargetName="FocusPriorityBadge" Property="Background" Value="#5A1F24" />
                    <Setter TargetName="FocusPriorityFlag" Property="Foreground" Value="#FF6B6B" />
                    <Setter TargetName="FocusPriorityLabel" Property="Foreground" Value="#FFD1D1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="high">
                    <Setter TargetName="FocusPriorityBadge" Property="Background" Value="#573A12" />
                    <Setter TargetName="FocusPriorityFlag" Property="Foreground" Value="#F59E0B" />
                    <Setter TargetName="FocusPriorityLabel" Property="Foreground" Value="#FFE2A8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="med">
                    <Setter TargetName="FocusPriorityBadge" Property="Background" Value="#143B42" />
                    <Setter TargetName="FocusPriorityFlag" Property="Foreground" Value="#2DD4BF" />
                    <Setter TargetName="FocusPriorityLabel" Property="Foreground" Value="#B8FFF5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="low">
                    <Setter TargetName="FocusPriorityBadge" Property="Background" Value="#202631" />
                    <Setter TargetName="FocusPriorityFlag" Property="Foreground" Value="#8B93A3" />
                    <Setter TargetName="FocusPriorityLabel" Property="Foreground" Value="#A1A8B5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="StatusBadgeTemplate">
            <Border x:Name="StatusBadge" MinWidth="94" Height="24" Padding="8,0" CornerRadius="6" Background="{StaticResource GrayBadgeBrush}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusDisplay}" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="in_progress">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource BlueBadgeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="review">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource PurpleBadgeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="done">
                    <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource GreenBadgeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="cancelled">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#444B57" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="blocked">
                    <Setter TargetName="StatusBadge" Property="Background" Value="#A34712" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
